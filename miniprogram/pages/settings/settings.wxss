/**
 * globesound 设置页样式
 */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx);
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  display: block;
  font-size: 26rpx;
  color: var(--color-muted);
  margin-bottom: 12rpx;
  margin-left: 8rpx;
  letter-spacing: 1rpx;
}

.card {
  background: var(--color-panel);
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  backdrop-filter: blur(20px);
}

.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.item:last-of-type {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: var(--color-text);
}

.value {
  font-size: 28rpx;
  color: rgba(232, 232, 236, 0.85);
}

.value-row {
  display: flex;
  align-items: center;
}

.desc {
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.6;
  margin-top: 16rpx;
  margin-bottom: 16rpx;
}

.text-mono {
  font-family: 'Menlo', 'Courier New', monospace;
  font-size: 24rpx;
}

.card-btn-row {
  margin-top: 20rpx;
}

.full-width {
  width: 100%;
}

.double-btn {
  display: flex;
  gap: 20rpx;
}

/* 说明项 */
.guide-item {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.guide-item:last-child {
  border-bottom: none;
}

.guide-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 181, 71, 0.15);
  border: 1rpx solid rgba(255, 181, 71, 0.4);
  color: var(--color-accent);
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.guide-content {
  flex: 1;
}

.guide-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: 6rpx;
}

.guide-text {
  display: block;
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.5;
}

/* ===== 坐标卡片 ===== */
.coord-card {
  background: rgba(255, 255, 255, 0.05);
}

.coord-val-wrap {
  padding: 10rpx 0 20rpx;
  text-align: center;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  margin-bottom: 8rpx;
}

.coord-val {
  font-family: 'Menlo', 'Courier New', monospace;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #ffb547;
}

/* ===== 电量数值显示 ===== */
.battery-val {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.06);
}

.battery-val.good {
  color: #68d391;
  background: rgba(72, 187, 120, 0.12);
}

.battery-val.medium {
  color: #f6ad55;
  background: rgba(246, 173, 85, 0.12);
}

.battery-val.low {
  color: #fc8181;
  background: rgba(245, 101, 101, 0.15);
}

.bat-icon {
  font-size: 24rpx;
}

.bat-text {
  font-size: 26rpx;
}

/* ===== 读数历史列表 ===== */
.fix-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.fix-item:last-child {
  border-bottom: none;
}

.fix-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.fix-index {
  font-size: 22rpx;
  color: rgba(232, 232, 236, 0.35);
  font-family: 'Menlo', 'Courier New', monospace;
  min-width: 44rpx;
}

.fix-coord {
  font-family: 'Menlo', 'Courier New', monospace;
  font-size: 28rpx;
  color: rgba(232, 232, 236, 0.85);
}

.fix-time {
  font-size: 22rpx;
  color: rgba(232, 232, 236, 0.4);
  font-family: 'Menlo', 'Courier New', monospace;
}

.empty-fixes {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: rgba(232, 232, 236, 0.35);
}
