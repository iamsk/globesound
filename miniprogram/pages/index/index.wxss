/**
  globesound 主页样式
  深色主题 + 玻璃拟态面板
  单屏自适应布局（禁止垂直滚动条），地图随屏幕弹性伸缩
*/

/* ===== 全局容器 ===== */
page {
  background: #05070d;
  color: #e8e8ec;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  height: 100vh;
  overflow: hidden;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 顶部状态与模式区 ===== */
.top-section {
  flex-shrink: 0;
  padding: 16rpx 24rpx 10rpx;
}

.status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.brand-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #e8e8ec;
  opacity: 0.9;
}

.settings-btn {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  font-size: 22rpx;
  color: rgba(232, 232, 236, 0.7);
}

.settings-btn:active {
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
}

.status-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 传感器电量胶囊 */
.battery-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.battery-pill .bat-icon {
  font-size: 24rpx;
  line-height: 1;
}

.battery-pill .bat-text {
  font-family: 'Menlo', 'Courier New', monospace;
  font-size: 22rpx;
}

.battery-pill.good {
  color: #68d391;
  background: rgba(72, 187, 120, 0.12);
  border-color: rgba(72, 187, 120, 0.28);
}

.battery-pill.medium {
  color: #f6ad55;
  background: rgba(246, 173, 85, 0.12);
  border-color: rgba(246, 173, 85, 0.28);
}

.battery-pill.low {
  color: #fc8181;
  background: rgba(245, 101, 101, 0.15);
  border-color: rgba(245, 101, 101, 0.35);
  animation: batPulse 1.8s infinite;
}

@keyframes batPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}

/* 连接与姿态状态胶囊 */
.status-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 6rpx 18rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20px);
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #6b7280;
  transition: background 0.3s ease;
}

.status-pill.moving .status-dot {
  background: #4fd1c5;
  box-shadow: 0 0 8rpx rgba(79, 209, 197, 0.6);
}

.status-pill.still .status-dot {
  background: #ffb547;
  box-shadow: 0 0 8rpx rgba(255, 181, 71, 0.6);
}

.status-text {
  font-size: 22rpx;
  color: rgba(232, 232, 236, 0.75);
}

/* 模式切换开关 */
.mode-switcher-wrap {
  display: flex;
  justify-content: center;
  margin-top: 4rpx;
}

.mode-switcher {
  display: flex;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 40rpx;
  padding: 4rpx;
  width: 100%;
}

.mode-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 10rpx 0;
  border-radius: 36rpx;
  transition: all 0.25s ease;
}

.mode-tab.active {
  background: rgba(255, 255, 255, 0.12);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.25);
}

.mode-icon {
  font-size: 26rpx;
}

.mode-title {
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(232, 232, 236, 0.7);
}

.mode-tab.active .mode-title {
  color: #ffffff;
  font-weight: 600;
}

/* ===== 地图区域（弹性撑满） ===== */
.map-section {
  flex: 1;
  min-height: 0;
  position: relative;
  margin: 8rpx 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.main-map {
  width: 100%;
  height: 100%;
}

/* 地图右上控制组（卫星图 + 缩放按钮） */
.map-ctrls-top {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: flex-end;
  z-index: 10;
}

.satellite-btn {
  padding: 8rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(5, 7, 13, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(20px);
}

.satellite-btn text {
  font-size: 22rpx;
  color: rgba(232, 232, 236, 0.85);
}

.zoom-btns {
  display: flex;
  flex-direction: column;
  background: rgba(5, 7, 13, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 18rpx;
  overflow: hidden;
  backdrop-filter: blur(20px);
}

.zoom-btn {
  width: 60rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 500;
  color: rgba(232, 232, 236, 0.85);
  transition: background 0.15s ease;
}

.zoom-btn:first-child {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.12);
}

.zoom-btn-hover {
  background: rgba(255, 255, 255, 0.2);
  color: #4fd1c5;
}

/* 回到跟随按钮 */
.follow-btn {
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  background: rgba(5, 7, 13, 0.88);
  border: 1rpx solid rgba(79, 209, 197, 0.4);
  backdrop-filter: blur(20px);
  z-index: 10;
}

.follow-btn text {
  font-size: 22rpx;
  color: #4fd1c5;
  font-weight: 500;
}

/* 地图右下浮动蓝牙胶囊 */
.ble-map-btn {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 22rpx;
  border-radius: 32rpx;
  background: rgba(5, 7, 13, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(20px);
  font-size: 22rpx;
  color: rgba(232, 232, 236, 0.85);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
  z-index: 10;
}

.ble-map-btn.connected {
  border-color: rgba(79, 209, 197, 0.4);
  color: #4fd1c5;
}

.ble-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #a0aec0;
}

.ble-map-btn.connected .ble-dot {
  background: #4fd1c5;
  box-shadow: 0 0 8rpx rgba(79, 209, 197, 0.8);
}

/* ===== 底部操作区 ===== */
.bottom-section {
  flex-shrink: 0;
  padding-bottom: 8rpx;
}

/* ===== Genre 筛选栏 ===== */
.genre-bar {
  padding: 8rpx 20rpx;
  white-space: nowrap;
}

.genre-chip {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  font-size: 22rpx;
  color: rgba(232, 232, 236, 0.6);
  transition: all 0.2s ease;
}

.genre-chip.active {
  background: rgba(79, 209, 197, 0.15);
  border-color: rgba(79, 209, 197, 0.4);
  color: #4fd1c5;
}

/* ===== 电台卡片 ===== */
.radio-card {
  margin: 8rpx 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20px);
}

.kicker {
  font-size: 20rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  color: rgba(232, 232, 236, 0.45);
  margin-bottom: 8rpx;
}

.kicker.locked {
  color: #ffb547;
}

.kicker.playing {
  color: #4fd1c5;
}

.station-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.station-meta {
  font-size: 22rpx;
  color: rgba(232, 232, 236, 0.5);
  display: block;
  margin-bottom: 4rpx;
}

.group-count {
  font-size: 20rpx;
  color: rgba(232, 232, 236, 0.35);
  display: block;
  margin-bottom: 16rpx;
}

.controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  padding-top: 6rpx;
}

.ctrl-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.2s ease;
}

.ctrl-btn:active {
  transform: scale(0.92);
  background: rgba(255, 255, 255, 0.12);
}

.ctrl-btn.play-btn {
  width: 88rpx;
  height: 88rpx;
  background: rgba(255, 107, 74, 0.15);
  border-color: rgba(255, 107, 74, 0.35);
}

.ctrl-btn.play-btn.playing {
  background: rgba(79, 209, 197, 0.15);
  border-color: rgba(79, 209, 197, 0.35);
}

.ctrl-icon {
  font-size: 28rpx;
  color: #e8e8ec;
}

.play-btn .ctrl-icon {
  color: #ff6b4a;
}

.play-btn.playing .ctrl-icon {
  color: #4fd1c5;
}

.start-listen {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: rgba(255, 107, 74, 0.12);
  border: 1rpx solid rgba(255, 107, 74, 0.3);
  transition: all 0.2s ease;
}

.start-listen:active {
  background: rgba(255, 107, 74, 0.2);
}

.start-listen text {
  font-size: 28rpx;
  color: #ff6b4a;
  font-weight: 500;
}

/* ===== 萌宝环球乐园卡片 ===== */
.kids-card {
  margin: 8rpx 20rpx;
  padding: 24rpx 28rpx 20rpx;
  border-radius: 28rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(24px);
  position: relative;
  overflow: hidden;
}

.kids-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.kids-badge {
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.kids-region {
  font-size: 22rpx;
  color: rgba(232, 232, 236, 0.6);
}

.kids-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 14rpx;
}

.kids-avatar-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.kids-avatar {
  font-size: 58rpx;
  line-height: 1;
}

.kids-info {
  flex: 1;
  min-width: 0;
}

.kids-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kids-action-bubble {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(255, 181, 71, 0.15);
  border: 1rpx solid rgba(255, 181, 71, 0.3);
}

.kids-action-text {
  font-size: 20rpx;
  color: #ffb547;
}

.kids-bubble {
  background: rgba(0, 0, 0, 0.25);
  border-left: 4rpx solid #ffb547;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 14rpx;
  display: flex;
}

.kids-bubble-quote {
  font-size: 24rpx;
  color: #ffb547;
  line-height: 1.4;
  opacity: 0.6;
}

.kids-bubble-text {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.4;
  color: rgba(232, 232, 236, 0.88);
  margin: 0 4rpx;
}

.kids-btn-row {
  margin-bottom: 10rpx;
}

.kids-play-btn {
  background: linear-gradient(135deg, #ff6b4a 0%, #ff8e53 100%);
  border: none;
  border-radius: 40rpx;
  padding: 14rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 74, 0.35);
}

.kids-play-btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.kids-play-btn.speaking {
  background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
  box-shadow: 0 6rpx 20rpx rgba(72, 187, 120, 0.45);
}

.kids-play-icon {
  font-size: 30rpx;
}

/* 附近候选萌友 */
.kids-candidates {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.candidates-title {
  display: block;
  font-size: 20rpx;
  color: rgba(232, 232, 236, 0.45);
  margin-bottom: 8rpx;
}

.candidate-list {
  white-space: nowrap;
  width: 100%;
}

.candidate-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  margin-right: 10rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  transition: all 0.2s ease;
}

.candidate-chip.active {
  background: rgba(255, 181, 71, 0.25);
  border-color: #ffb547;
}

.cand-emoji {
  font-size: 24rpx;
}

.cand-name {
  font-size: 22rpx;
  color: #e8e8ec;
}
